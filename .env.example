# Environment Configuration for Automated Video Dubbing System

# Whisper Speech Recognition
# Options: tiny, base, small, medium, large, large-v3-turbo, turbo
WHISPER_MODEL=base

# Device configuration (cuda or cpu)
DEVICE=cuda

# IndicTrans2 ONNX Model Repository
INDICTRANS_MODEL=hari31416/indictrans2-indic-en-dist-200M-ONNX

# Default Edge-TTS English Voice
# Popular options:
# en-US-ChristopherNeural (Male, Natural American)
# en-US-JennyNeural (Female, Expressive American)
# en-US-GuyNeural (Male, American)
# en-GB-SoniaNeural (Female, British)
DEFAULT_TTS_VOICE=en-US-ChristopherNeural

# Pipeline Directories
DATA_DIR=data
JOBS_DIR=data/jobs
CACHE_DIR=data/cache
OUTPUTS_DIR=data/outputs

# API Server Configuration
HOST=0.0.0.0
PORT=8000
